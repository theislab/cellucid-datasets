  "ownership": {
    "source_owned": [
      "raw integer counts X and the ordered cell identifiers",
      "every obs column and its category order",
      "the scVI latent representation obsm['scvi']",
      "the unintegrated PCA obsm['X_pca'], published as its first two components",
      "the integration pipeline's own 2D UMAP obsm['X_umap']",
      "the upstream gene identifiers in varnames/, aligned to the matrix columns by position"
    ],
    "derived": [
      "the dropped scVI bookkeeping columns _scvi_batch and _scvi_labels",
      "age as a continuous field, converted from its categorical numeric strings",
      "one 15-nearest-neighbour graph on obsm['scvi'], which is also the published connectivity",
      "the 1D, 2D and 3D UMAPs of that one graph",
      "gene symbols resolved through ensembl_to_hgnc.pickle; genes without one are not published"
    ]
  },
